rules_version = '2';
// コマドリのアクセスルール（テスト：npm run test:rules）
// - 調整の ID（推測できない20文字）を知っている人は誰でも見られる。一覧は取れない（ID を知らないと読めない）
// - 調整・回答への書き込みはすべて /api（Cloud Functions。functions/index.js）から。形と大きさはそこで確かめる
//   （広告ブロックなどで Google のログインや Firestore への書き込みの通信が止められていても保存できるように、サイトと同じアドレスで受ける）
// - Google とつないだ人（任意）は、自分の日程調整の一覧を users/{uid} に置く。読み書きは本人だけ
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }

    // 調整・回答・履歴・場所の空き状況：ID を知っていれば誰でも読める。書くのは /api（Cloud Functions）だけ
    match /polls/{pollId} {
      allow get: if true;
      allow list: if false;
      allow write: if false;

      match /places/{docId} {
        allow read: if true;
        allow write: if false;
      }
      match /people/{personId} {
        allow read: if true;
        allow write: if false;
        match /log/{logId} {
          allow read: if true;
          allow write: if false;
        }
      }
    }

    match /users/{uid} {
      allow read: if signedIn() && request.auth.uid == uid;
      allow create, update: if signedIn() && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['recent', 'updatedAt'])
        && request.resource.data.recent is list && request.resource.data.recent.size() <= 50
        && request.resource.data.updatedAt == request.time;
      allow delete: if false;
    }

    match /{document=**} { allow read, write: if false; }
  }
}
